{
  "openapi": "3.0.0",
  "info": {
    "title": "Tableau VDS Query API",
    "description": "Queries live Tableau data sources via the VizQL Data Service API.",
    "version": "2.0.0"
  },
  "servers": [
    {
      "url": "https://Test-Azure-func6.azurewebsites.net/api"
    }
  ],
  "paths": {
    "/query": {
      "post": {
        "operationId": "queryTableauData",
        "summary": "Query live Tableau data",
        "description": "Queries the Tableau datasource configured in the Function App. Use fieldCaption to specify fields and function to apply aggregation (SUM, AVG, COUNT, COUNTD, MIN, MAX, MEDIAN) or date truncation (YEAR, QUARTER, MONTH, WEEK, DAY).",
        "parameters": [
          {
            "name": "code",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "default": "YOUR_FUNCTION_KEY"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["query_fields"],
                "properties": {
                  "query_fields": {
                    "type": "array",
                    "description": "Fields to query. Each field requires a fieldCaption. Measures and dates should include a function.",
                    "items": {
                      "type": "object",
                      "required": ["fieldCaption"],
                      "properties": {
                        "fieldCaption": {
                          "type": "string",
                          "description": "Exact field name from the Tableau datasource"
                        },
                        "function": {
                          "type": "string",
                          "description": "Aggregation or date function. Measures: SUM, AVG, COUNT, COUNTD, MIN, MAX, MEDIAN. Dates: YEAR, QUARTER, MONTH, WEEK, DAY.",
                          "enum": [
                            "SUM", "AVG", "COUNT", "COUNTD", "MIN", "MAX", "MEDIAN",
                            "YEAR", "QUARTER", "MONTH", "WEEK", "DAY"
                          ]
                        }
                      }
                    },
                    "example": [
                      {"fieldCaption": "Order Date", "function": "YEAR"},
                      {"fieldCaption": "Category"},
                      {"fieldCaption": "Sales", "function": "SUM"},
                      {"fieldCaption": "Profit", "function": "SUM"}
                    ]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Query results",
            "content": {
              "application/json": {
                "schema": {"type": "object"}
              }
            }
          }
        }
      }
    }
  }
}
